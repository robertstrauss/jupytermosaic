{
  "jupyter.lab.setting-icon": "mosaic:favicon",
  "jupyter.lab.setting-icon-label": "Mosaic",
  "title": "Mosaic Notebook Settings",
  "description": "Controls global stylistic features of the mosaic notebook.",
  "type": "object",
  "properties": {
    "skeuomorphic": {
      "type": "boolean",
      "title": "Skeuomorphic Style (Floating Cell Bubbles)",
      "default": false,
      "description": "Stylize cells as seperate, floating, and round, rather than the default flat, seamless view."
    },
    "topCellHandle": {
      "type": "boolean",
      "title": "Cell Handle Placement",
      "default": false,
      "description": "Put cell handles above code areas rather than beside it"
    }
  },
  "jupyter.lab.toolbars": {
    "Cell": [
      {
        "name": "duplicate-cell",
        "rank": 10
      },
      {
        "name": "move-cell-up",
        "rank": 20
      },
      {
        "name": "move-cell-down",
        "rank": 30
      },
      {
        "name": "insert-cell-above",
        "rank": 40
      },
      {
        "name": "insert-cell-below",
        "rank": 50
      },
      {
        "name": "mosaic-insert-cell-left",
        "command": "mosaic:insert-cell-left",
        "rank": 51
      },
      {
        "name": "mosaic-insert-cell-right",
        "command": "mosaic:insert-cell-right",
        "rank": 52
      },
      {
        "name": "delete-cell",
        "rank": 60
      }
    ]
  },
  "jupyter.lab.shortcuts": [
    {
      "command": "mosaic:move-cursor-left",
      "keys": [
        "H"
      ],
      "selector": ".jp-Notebook.mosaic-Notebook:focus"
    },
    {
      "command": "mosaic:extend-selection-left",
      "keys": [
        "Shift H"
      ],
      "selector": ".jp-Notebook.mosaic-Notebook:focus"
    },
    {
      "command": "mosaic:move-cursor-right",
      "keys": [
        ";"
      ],
      "selector": ".jp-Notebook.mosaic-Notebook:focus"
    },
    {
      "command": "mosaic:extend-selection-right",
      "keys": [
        "Shift ;"
      ],
      "selector": ".jp-Notebook.mosaic-Notebook:focus"
    },
    {
      "command": "mosaic:move-cursor-down",
      "keys": [
        "J"
      ],
      "selector": ".jp-Notebook.mosaic-Notebook:focus"
    },
    {
      "command": "mosaic:extend-selection-down",
      "keys": [
        "Shift J"
      ],
      "selector": ".jp-Notebook.mosaic-Notebook:focus"
    },
    {
      "command": "mosaic:move-cursor-up",
      "keys": [
        "K"
      ],
      "selector": ".jp-Notebook.mosaic-Notebook:focus"
    },
    {
      "command": "mosaic:extend-selection-up",
      "keys": [
        "Shift K"
      ],
      "selector": ".jp-Notebook.mosaic-Notebook:focus"
    }
  ]
}
